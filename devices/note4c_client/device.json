{
  "tesserae_compat": "1.x",
  "name": "ZecTrix NOTE4C Devkit",
  "icon": "device-tablet",
  "version": "0.1.0",
  "description": "ZecTrix NOTE4C Devkit integration by varanu5. Battery-powered 400x300 four-colour e-paper display. Firmware: https://github.com/varanu5/zectrix-note4c-devkit-tesserae-client",
  "renderers": [
    "esp32_bin"
  ],
  "status_topic": "tesserae/note4c/status",
  "config_topic": "tesserae/note4c/config",
  "panel": {
    "w": 400,
    "h": 300,
    "orientation": "landscape",
    "name": "ZecTrix NOTE4C Devkit BWRY",
    "gamut": "bwry_4",
    "vflip": false
  },
  "config_schema": {
    "sleep_interval_s": {
      "type": "int",
      "label": "Sleep interval",
      "default": 900,
      "min": 30,
      "max": 604800,
      "presets": [
        {
          "value": 60,
          "label": "1 minute"
        },
        {
          "value": 300,
          "label": "5 minutes"
        },
        {
          "value": 900,
          "label": "15 minutes"
        },
        {
          "value": 1800,
          "label": "30 minutes"
        },
        {
          "value": 3600,
          "label": "1 hour"
        },
        {
          "value": 21600,
          "label": "6 hours"
        },
        {
          "value": 43200,
          "label": "12 hours"
        },
        {
          "value": 86400,
          "label": "1 day"
        }
      ],
      "help": "How long the frame sleeps between fetches. Defaults to 15 minutes; change it here to suit your needs. Longer intervals extend battery life. Custom value is in seconds."
    }
  }
}
