{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, Energy",
  "version": "0.4.1",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "Live solar / grid / battery / house-consumption snapshot from your HA energy dashboard, with today's totals, optional yesterday's solar total, and a 24-hour sparkline. Wires to the same sensor.* entities you've already configured under HA's Energy panel.",
  "icon": "ph-lightning",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "solar_entity",
      "type": "select",
      "label": "Solar power",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "grid_entity",
      "type": "select",
      "label": "Grid power",
      "default": "",
      "choices_from": "entity",
      "help": "Positive while importing, negative while exporting."
    },
    {
      "name": "battery_entity",
      "type": "select",
      "label": "Battery power",
      "default": "",
      "choices_from": "entity",
      "help": "Positive while charging, negative while discharging."
    },
    {
      "name": "house_entity",
      "type": "select",
      "label": "House consumption",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "solar_today_entity",
      "type": "select",
      "label": "Solar energy today",
      "default": "",
      "show_if": {
        "solar_entity": {
          "not": ""
        }
      },
      "advanced": true,
      "choices_from": "entity",
      "help": "Optional. Today's solar production, in kWh."
    },
    {
      "name": "show_solar_yesterday",
      "type": "boolean",
      "label": "Yesterday's solar",
      "default": false,
      "show_if": {
        "solar_today_entity": {
          "not": ""
        }
      },
      "advanced": true,
      "help": "Yesterday's solar production beside today's."
    },
    {
      "name": "battery_soc_entity",
      "type": "select",
      "label": "Battery charge",
      "default": "",
      "show_if": {
        "battery_entity": {
          "not": ""
        }
      },
      "advanced": true,
      "choices_from": "entity",
      "help": "Optional. The battery's state of charge, in percent."
    },
    {
      "name": "label",
      "type": "string",
      "label": "Place name",
      "default": "Home",
      "advanced": true
    }
  ],
  "fragments": [
    { "id": "full", "label": "Full card", "w": 320, "h": 260, "icon": "ph-lightning" },
    { "id": "sankey", "label": "Flow diagram", "w": 300, "h": 200, "icon": "ph-flow-arrow" },
    { "id": "trend", "label": "Today vs yesterday", "w": 300, "h": 90, "icon": "ph-chart-line" },
    { "id": "stats", "label": "Battery + solar", "w": 200, "h": 90, "icon": "ph-battery-charging" }
  ],
  "render": {
    "dither": "none",
    "needs_network": false
  }
}
